@model IEnumerable<Sale>
@{ViewData["Title"]="Sales";}<div class="container py-4"><div class="page-header"><div><h1>Sales</h1><p>Sales invoices and stock-out transactions.</p></div><a class="btn btn-success" asp-action="Create">New Sale</a></div><div class="content-card"><table class="table"><thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Total</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.InvoiceNo</td><td>@s.Customer?.Name</td><td>@s.SaleDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>Rs. @s.TotalAmount.ToString("N2")</td><td>@s.Status</td><td><a class="btn btn-sm btn-outline-success" asp-action="Details" asp-route-id="@s.Id">Details</a></td></tr>}</tbody></table></div></div>
