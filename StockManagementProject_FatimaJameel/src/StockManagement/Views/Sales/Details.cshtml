@model Sale
@{ViewData["Title"]="Sale Details";}<div class="container py-4"><div class="content-card"><div class="page-header"><div><h1>@Model.InvoiceNo</h1><p>Customer: @(Model.Customer?.Name ?? "Walk-in")</p></div><strong>Rs. @Model.TotalAmount.ToString("N2")</strong></div><table class="table"><thead><tr><th>Product</th><th>Qty</th><th>Unit Price</th><th>Total</th></tr></thead><tbody>@foreach(var d in Model.Details){<tr><td>@d.Product?.Name</td><td>@d.Quantity</td><td>Rs. @d.UnitPrice.ToString("N2")</td><td>Rs. @d.LineTotal.ToString("N2")</td></tr>}</tbody></table></div></div>
