@model SaleCreateVm
@{ViewData["Title"]="New Sale";}<div class="container py-4"><div class="page-header"><div><h1>New Sale</h1><p>Stock is reduced automatically inside a database transaction.</p></div></div><div class="content-card"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-4"><label>Customer</label><select asp-for="CustomerId" class="form-select"><option value="">Walk-in Customer</option>@foreach(var c in (IEnumerable<Customer>)ViewBag.Customers){<option value="@c.Id">@c.Name</option>}</select></div><div id="lines">@for(int i=0;i<Model.Lines.Count;i++){<div class="row g-2 line mb-2"><div class="col-md-6"><select name="Lines[@i].ProductId" class="form-select product"><option value="">Select product</option>@foreach(var p in (IEnumerable<Product>)ViewBag.Products){<option value="@p.Id">@p.Name (@p.CurrentStock in stock)</option>}</select></div><div class="col-md-2"><input name="Lines[@i].Quantity" type="number" min="1" value="@Model.Lines[i].Quantity" class="form-control" placeholder="Qty"/></div><div class="col-md-3"><input name="Lines[@i].UnitPrice" type="number" step="0.01" min="0" value="@Model.Lines[i].UnitPrice" class="form-control" placeholder="Unit price"/></div></div>}</div><button type="button" class="btn btn-outline-success btn-sm" onclick="addLine()">+ Add Line</button><div class="mt-4"><button class="btn btn-success">Save Sale</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div></div><script>function addLine(){const i=document.querySelectorAll('.line').length;const opts=document.querySelector('.product').innerHTML;document.getElementById('lines').insertAdjacentHTML('beforeend',`<div class="row g-2 line mb-2"><div class="col-md-6"><select name="Lines[${i}].ProductId" class="form-select product">${opts}</select></div><div class="col-md-2"><input name="Lines[${i}].Quantity" type="number" min="1" value="1" class="form-control"></div><div class="col-md-3"><input name="Lines[${i}].UnitPrice" type="number" step="0.01" min="0" class="form-control" placeholder="Unit price"></div></div>`);}</script>
