@model IEnumerable<AuditLog>
@{ViewData["Title"]="Audit Logs";}<div class="container py-4"><div class="page-header"><div><h1>Audit Logs</h1><p>Track important inventory system changes.</p></div></div><div class="content-card"><div class="table-responsive"><table class="table"><thead><tr><th>Date</th><th>Entity</th><th>Action</th><th>Description</th><th>Changed By</th></tr></thead><tbody>@foreach(var l in Model){<tr><td>@l.ChangedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>@l.EntityName</td><td>@l.ActionType</td><td>@l.Description</td><td>@l.ChangedBy</td></tr>}</tbody></table></div></div></div>
