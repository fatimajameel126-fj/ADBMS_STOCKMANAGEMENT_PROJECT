@model IEnumerable<AppUser>
@{ViewData["Title"]="Users";}<div class="container py-4"><div class="page-header"><div><h1>Users</h1><p>Manage system access.</p></div></div><div class="content-card"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var u in Model){<tr><td>@u.FullName</td><td>@u.Email</td><td>@u.Role</td><td>@(u.IsActive?"Active":"Disabled")</td><td><form method="post" asp-action="ToggleUser" asp-route-id="@u.Id"><button class="btn btn-sm btn-outline-success">Toggle</button></form></td></tr>}</tbody></table></div></div>
