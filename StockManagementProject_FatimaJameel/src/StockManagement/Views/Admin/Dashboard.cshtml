@model DashboardVm
@{ViewData["Title"]="Dashboard";}<div class="admin-shell"><aside class="admin-sidebar"><div class="sidebar-card"><div class="sidebar-title"><i class="bi bi-grid-1x2-fill me-2"></i>Inventory Control</div><a class="side-link active" asp-controller="Admin" asp-action="Dashboard"><i class="bi bi-speedometer2"></i>Dashboard</a><a class="side-link" asp-controller="Products" asp-action="Index"><i class="bi bi-box"></i>Products</a><a class="side-link" asp-controller="Categories" asp-action="Index"><i class="bi bi-tags"></i>Categories</a><a class="side-link" asp-controller="Suppliers" asp-action="Index"><i class="bi bi-truck"></i>Suppliers</a><a class="side-link" asp-controller="Customers" asp-action="Index"><i class="bi bi-people"></i>Customers</a><a class="side-link" asp-controller="Purchases" asp-action="Index"><i class="bi bi-cart-plus"></i>Purchases</a><a class="side-link" asp-controller="Sales" asp-action="Index"><i class="bi bi-cart-check"></i>Sales</a><a class="side-link" asp-controller="Reports" asp-action="Stock"><i class="bi bi-bar-chart"></i>Reports</a><a class="side-link" asp-controller="Admin" asp-action="Users"><i class="bi bi-person-gear"></i>Users</a><a class="side-link" asp-controller="Admin" asp-action="AuditLogs"><i class="bi bi-clock-history"></i>Audit Logs</a></div></aside><section class="admin-content"><div class="page-head"><div><h1>Dashboard</h1><p>Overview of stock, sales and purchasing activity.</p></div><a class="btn btn-success" asp-controller="Products" asp-action="Create"><i class="bi bi-plus-lg me-1"></i>Add Product</a></div><div class="row g-3 mb-4"><div class="col-md-3"><div class="stat-card"><span>Products</span><strong>@Model.Products</strong><i class="bi bi-box"></i></div></div><div class="col-md-3"><div class="stat-card"><span>Suppliers</span><strong>@Model.Suppliers</strong><i class="bi bi-truck"></i></div></div><div class="col-md-3"><div class="stat-card"><span>Low Stock</span><strong>@Model.LowStock</strong><i class="bi bi-exclamation-triangle"></i></div></div><div class="col-md-3"><div class="stat-card"><span>Customers</span><strong>@Model.Customers</strong><i class="bi bi-people"></i></div></div></div><div class="row g-4"><div class="col-lg-7"><div class="panel-card"><div class="panel-head"><h5>Low Stock Products</h5><a asp-controller="Reports" asp-action="Stock">View report</a></div><div class="table-responsive"><table class="table"><thead><tr><th>SKU</th><th>Product</th><th>Category</th><th>Stock</th><th>Reorder</th></tr></thead><tbody>@foreach(var p in Model.LowStockProducts){<tr><td>@p.SKU</td><td>@p.Name</td><td>@p.Category?.Name</td><td><span class="badge bg-danger">@p.CurrentStock</span></td><td>@p.ReorderLevel</td></tr>}@if(!Model.LowStockProducts.Any()){<tr><td colspan="5" class="text-muted">No low-stock products.</td></tr>}</tbody></table></div></div></div><div class="col-lg-5"><div class="panel-card"><div class="panel-head"><h5>Today</h5></div><div class="row g-3"><div class="col-6"><div class="mini-stat"><span>Sales</span><strong>Rs. @Model.SalesToday.ToString("N0")</strong></div></div><div class="col-6"><div class="mini-stat"><span>Purchases</span><strong>Rs. @Model.PurchasesToday.ToString("N0")</strong></div></div></div><hr/><div class="panel-head"><h5>Recent Sales</h5></div>@foreach(var s in Model.RecentSales){<div class="list-line"><div><strong>@s.InvoiceNo</strong><small class="d-block text-muted">@s.Customer?.Name</small></div><strong>Rs. @s.TotalAmount.ToString("N0")</strong></div>}</div></div></div></section></div>
