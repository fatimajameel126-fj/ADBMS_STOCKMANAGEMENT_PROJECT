@model IEnumerable<Supplier>
@{ViewData["Title"]="Suppliers";}<div class="container py-4"><div class="page-header"><div><h1>Suppliers</h1><p>Manage supplier information.</p></div><a class="btn btn-success" asp-action="Create">Add Supplier</a></div><form class="card-filter" method="get"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search supplier"/><button class="btn btn-outline-success">Search</button></form><div class="content-card"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th>Address</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Name</td><td>@s.Email</td><td>@s.Phone</td><td>@s.Address</td><td>@(s.IsActive?"Active":"Inactive")</td><td class="text-end"><a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@s.Id">Edit</a><form class="d-inline" method="post" asp-action="Delete" asp-route-id="@s.Id"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
