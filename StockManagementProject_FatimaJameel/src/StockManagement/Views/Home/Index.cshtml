@{ViewData["Title"]="Home";}<section class="hero-section"><div class="container py-5"><div class="row align-items-center g-5"><div class="col-lg-7"><div class="eyebrow">ADBMS Project by fatima jameel</div><h1 class="display-4 fw-bold">Stock Management System</h1><p class="lead text-muted">A web-based inventory system for managing products, suppliers, purchases, sales, stock levels and reports using ASP.NET Core, C# and SQL Server.</p><a class="btn btn-success btn-lg" asp-controller="Auth" asp-action="Login">Open System</a></div><div class="col-lg-5"><div class="hero-card"><h5 class="fw-bold">Core Modules</h5><div class="module-tile"><i class="bi bi-box"></i><span>Products & Inventory</span></div><div class="module-tile"><i class="bi bi-truck"></i><span>Suppliers & Purchases</span></div><div class="module-tile"><i class="bi bi-cart-check"></i><span>Sales & Customers</span></div><div class="module-tile"><i class="bi bi-bar-chart"></i><span>Reports & Audit Logs</span></div></div></div></div></div></section><section class="py-5"><div class="container"><div class="row g-4"><div class="col-md-4"><div class="feature-card"><i class="bi bi-database"></i><h5>Relational Database</h5><p>SQL Server database with keys, constraints, relationships, indexes and normalization.</p></div></div><div class="col-md-4"><div class="feature-card"><i class="bi bi-lightning-charge"></i><h5>ADBMS Features</h5><p>Views, stored procedures, functions, triggers and transaction-based stock updates.</p></div></div><div class="col-md-4"><div class="feature-card"><i class="bi bi-shield-check"></i><h5>Role-Based Access</h5><p>Separate access for Admin, Manager and Staff users with cookie authentication.</p></div></div></div></div></section>
