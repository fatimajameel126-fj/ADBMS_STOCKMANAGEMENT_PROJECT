@model IEnumerable<Customer>
@{ViewData["Title"]="Customers";}<div class="container py-4"><div class="page-header"><div><h1>Customers</h1><p>Manage customers for sales invoices.</p></div><a class="btn btn-success" asp-action="Create">Add Customer</a></div><div class="content-card"><table class="table"><thead><tr><th>Name</th><th>Email</th><th>Phone</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Email</td><td>@c.Phone</td><td class="text-end"><a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@c.Id">Edit</a><form class="d-inline" method="post" asp-action="Delete" asp-route-id="@c.Id"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
