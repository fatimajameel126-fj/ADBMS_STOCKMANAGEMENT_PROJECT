@model PurchaseCreateVm
@{ViewData["Title"]="New Purchase";}<div class="container py-4"><div class="page-header"><div><h1>New Purchase</h1><p>Stock is increased automatically inside a database transaction.</p></div></div><div class="content-card"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div><div class="mb-4"><label>Supplier</label><select asp-for="SupplierId" class="form-select"><option value="">Select supplier</option>@foreach(var s in (IEnumerable<Supplier>)ViewBag.Suppliers){<option value="@s.Id">@s.Name</option>}</select></div><div id="lines">@for(int i=0;i<Model.Lines.Count;i++){<div class="row g-2 line mb-2"><div class="col-md-6"><select name="Lines[@i].ProductId" class="form-select product"><option value="">Select product</option>@foreach(var p in (IEnumerable<Product>)ViewBag.Products){<option value="@p.Id">@p.Name</option>}</select></div><div class="col-md-2"><input name="Lines[@i].Quantity" type="number" min="1" value="@Model.Lines[i].Quantity" class="form-control" placeholder="Qty"/></div><div class="col-md-3"><input name="Lines[@i].UnitCost" type="number" step="0.01" min="0" value="@Model.Lines[i].UnitCost" class="form-control" placeholder="Unit cost"/></div></div>}</div><button type="button" class="btn btn-outline-success btn-sm" onclick="addLine()">+ Add Line</button><div class="mt-4"><button class="btn btn-success">Save Purchase</button> <a asp-action="Index" class="btn btn-light">Cancel</a></div></form></div></div><script>function addLine(){const i=document.querySelectorAll('.line').length;const opts=document.querySelector('.product').innerHTML;document.getElementById('lines').insertAdjacentHTML('beforeend',`<div class="row g-2 line mb-2"><div class="col-md-6"><select name="Lines[${i}].ProductId" class="form-select product">${opts}</select></div><div class="col-md-2"><input name="Lines[${i}].Quantity" type="number" min="1" value="1" class="form-control"></div><div class="col-md-3"><input name="Lines[${i}].UnitCost" type="number" step="0.01" min="0" class="form-control" placeholder="Unit cost"></div></div>`);}</script>
