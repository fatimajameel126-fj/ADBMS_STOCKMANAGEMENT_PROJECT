@model IEnumerable<Purchase>
@{ViewData["Title"]="Purchases";}<div class="container py-4"><div class="page-header"><div><h1>Purchases</h1><p>Purchase invoices and stock-in transactions.</p></div><a class="btn btn-success" asp-action="Create">New Purchase</a></div><div class="content-card"><table class="table"><thead><tr><th>Invoice</th><th>Supplier</th><th>Date</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.InvoiceNo</td><td>@p.Supplier?.Name</td><td>@p.PurchaseDate.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td><td>Rs. @p.TotalAmount.ToString("N2")</td><td><a class="btn btn-sm btn-outline-success" asp-action="Details" asp-route-id="@p.Id">Details</a></td></tr>}</tbody></table></div></div>
