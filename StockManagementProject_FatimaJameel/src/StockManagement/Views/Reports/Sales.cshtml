@model IEnumerable<Sale>
@{ViewData["Title"]="Sales Report";}<div class="container py-4"><div class="page-header"><div><h1>Sales Report</h1><p>Sales for the last 30 days.</p></div><strong>Rs. @(((decimal)ViewBag.Total).ToString("N2"))</strong></div><div class="content-card"><table class="table"><thead><tr><th>Invoice</th><th>Customer</th><th>Date</th><th>Total</th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.InvoiceNo</td><td>@s.Customer?.Name</td><td>@s.SaleDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>Rs. @s.TotalAmount.ToString("N2")</td></tr>}</tbody></table></div></div>
