@model IEnumerable<Product>
@{ViewData["Title"]="Stock Report";}<div class="container py-4"><div class="page-header"><div><h1>Stock Report</h1><p>Current inventory position and reorder monitoring.</p></div></div><div class="content-card"><table class="table"><thead><tr><th>SKU</th><th>Product</th><th>Category</th><th>Stock</th><th>Reorder Level</th><th>Unit Price</th><th>Value</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.SKU</td><td>@p.Name</td><td>@p.Category?.Name</td><td class="@(p.CurrentStock<=p.ReorderLevel?"text-danger fw-bold":"")">@p.CurrentStock</td><td>@p.ReorderLevel</td><td>Rs. @p.UnitPrice.ToString("N2")</td><td>Rs. @((p.CurrentStock*p.UnitPrice).ToString("N2"))</td></tr>}</tbody></table></div></div>
