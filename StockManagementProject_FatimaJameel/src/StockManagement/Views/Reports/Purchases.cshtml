@model IEnumerable<Purchase>
@{ViewData["Title"]="Purchase Report";}<div class="container py-4"><div class="page-header"><div><h1>Purchase Report</h1><p>Purchases for the last 30 days.</p></div><strong>Rs. @(((decimal)ViewBag.Total).ToString("N2"))</strong></div><div class="content-card"><table class="table"><thead><tr><th>Invoice</th><th>Supplier</th><th>Date</th><th>Total</th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.InvoiceNo</td><td>@p.Supplier?.Name</td><td>@p.PurchaseDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>Rs. @p.TotalAmount.ToString("N2")</td></tr>}</tbody></table></div></div>
