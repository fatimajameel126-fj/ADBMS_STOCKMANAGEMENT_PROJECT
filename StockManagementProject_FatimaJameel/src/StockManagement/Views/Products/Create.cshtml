@model Product
@{ViewData["Title"]="Add Product";}<div class="container py-4"><div class="page-header"><div><h1>Add Product</h1><p>Create a new inventory item.</p></div></div><div class="content-card form-card"><form method="post"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="SKU"></label><input asp-for="SKU" class="form-control"/></div><div class="col-md-6"><label asp-for="Name"></label><input asp-for="Name" class="form-control"/></div><div class="col-md-6"><label asp-for="CategoryId">Category</label><select asp-for="CategoryId" class="form-select"><option value="">Select</option>@foreach(var c in (IEnumerable<Category>)ViewBag.Categories){<option value="@c.Id">@c.Name</option>}</select></div><div class="col-md-3"><label asp-for="Unit"></label><input asp-for="Unit" class="form-control"/></div><div class="col-md-3"><label asp-for="UnitPrice"></label><input asp-for="UnitPrice" class="form-control"/></div><div class="col-md-4"><label asp-for="ReorderLevel"></label><input asp-for="ReorderLevel" class="form-control"/></div><div class="col-md-4"><label asp-for="CurrentStock"></label><input asp-for="CurrentStock" class="form-control"/></div><div class="col-md-4"><label asp-for="Status"></label><select asp-for="Status" class="form-select"><option>Active</option><option>Inactive</option></select></div></div><div class="mt-4"><button class="btn btn-success">Save</button> <a class="btn btn-light" asp-action="Index">Cancel</a></div></form></div></div>
