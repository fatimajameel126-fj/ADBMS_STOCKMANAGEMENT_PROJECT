@model IEnumerable<Product>
@{ViewData["Title"]="Products";}<div class="container-fluid px-3 px-lg-4 py-4"><div class="page-header"><div><div class="eyebrow">Inventory</div><h1>Products</h1><p>Manage products, prices and stock thresholds.</p></div><a class="btn btn-success" asp-action="Create">Add Product</a></div><form class="card-filter" method="get"><input name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by SKU or product name"/><button class="btn btn-outline-success">Search</button></form><div class="content-card"><div class="table-responsive"><table class="table"><thead><tr><th>SKU</th><th>Name</th><th>Category</th><th>Price</th><th>Stock</th><th>Reorder</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td>@p.SKU</td><td>@p.Name</td><td>@p.Category?.Name</td><td>Rs. @p.UnitPrice.ToString("N2")</td><td><span class="badge @(p.CurrentStock<=p.ReorderLevel?"bg-danger":"bg-success")">@p.CurrentStock</span></td><td>@p.ReorderLevel</td><td>@p.Status</td><td class="text-end"><a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@p.Id">Edit</a><form asp-action="Delete" asp-route-id="@p.Id" method="post" class="d-inline"><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this product?')">Delete</button></form></td></tr>}</tbody></table></div></div></div>
