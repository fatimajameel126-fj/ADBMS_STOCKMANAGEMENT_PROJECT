@model IEnumerable<Category>
@{ViewData["Title"]="Categories";}<div class="container py-4"><div class="page-header"><div><h1>Categories</h1><p>Organize products into categories.</p></div><a class="btn btn-success" asp-action="Create">Add Category</a></div><div class="content-card"><table class="table"><thead><tr><th>Name</th><th>Description</th><th>Products</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.Name</td><td>@c.Description</td><td>@c.Products.Count</td><td class="text-end"><a class="btn btn-sm btn-outline-success" asp-action="Edit" asp-route-id="@c.Id">Edit</a><form class="d-inline" method="post" asp-action="Delete" asp-route-id="@c.Id"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div>
